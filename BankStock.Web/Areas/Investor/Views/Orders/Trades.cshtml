@model PagedListViewModel<TradeListItem, TradeListQuery>
@{
    ViewData["Title"] = Localizer["NavTrades"];
    var q = Model.Query;
}

<partial name="_InvestorNav" />

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-check2-all text-primary me-2"></i>@Localizer["TradeHistoryTitle"]</h4>
        <p class="text-secondary small mb-0">@Localizer["TradeHistorySubtitle"]</p>
    </div>
</div>

<form id="listFilterForm" class="stock-card filter-panel mb-3" method="get" asp-action="Trades" role="search">
    <div class="row g-3 align-items-end">
        <div class="col-lg-2 col-md-4 col-6">
            <label for="filterStock" class="form-label small text-secondary">@Localizer["FieldStockCode"]</label>
            <select id="filterStock" name="stockId" class="form-select form-select-sm">
                <option value="" selected="@(q.StockId is null)">@Localizer["FilterAll"]</option>
                @foreach (var stock in Model.StockOptions)
                {
                    <option value="@stock.Id" selected="@(q.StockId == stock.Id)">@stock.StockCode</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <label for="filterType" class="form-label small text-secondary">@Localizer["FieldOrderType"]</label>
            <select id="filterType" name="type" class="form-select form-select-sm">
                <option value="" selected="@(q.Type is null)">@Localizer["FilterAll"]</option>
                @foreach (var type in Enum.GetValues<OrderType>())
                {
                    <option value="@type" selected="@(q.Type == type)">@Localizer["OrderType" + type]</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-2 col-6">
            <label for="filterFrom" class="form-label small text-secondary">@Localizer["FieldFromDate"]</label>
            <input type="date" id="filterFrom" name="from" value="@q.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-lg-2 col-md-2 col-6">
            <label for="filterTo" class="form-label small text-secondary">@Localizer["FieldToDate"]</label>
            <input type="date" id="filterTo" name="to" value="@q.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <partial name="_FilterActions" model="Model.Query" />
    </div>
</form>

<div id="listResults" aria-live="polite">
    <partial name="_TradeList" model="Model" />
</div>

@section Scripts {
    <script src="~/js/ajax-list.js" asp-append-version="true"></script>
}
