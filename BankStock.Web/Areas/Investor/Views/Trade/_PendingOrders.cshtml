@model IReadOnlyList<OrderListItem>
@if (Model.Count == 0)
{
    <p class="text-muted text-center small py-4 mb-0">@Localizer["TradeNoPending"]</p>
}
else
{
    <div class="table-responsive">
        <table class="fintech-table">
            <thead>
                <tr>
                    <th class="ps-3">@Localizer["ThStockCode"]</th>
                    <th>@Localizer["FieldOrderType"]</th>
                    <th class="text-end">@Localizer["FieldQuantity"]</th>
                    <th class="text-end">@Localizer["FieldOrderPrice"]</th>
                    <th class="d-none d-sm-table-cell">@Localizer["AdminTime"]</th>
                    <th class="text-end pe-3"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="ps-3"><span class="stock-code-badge stock-ref">@order.StockCode</span></td>
                        <td><partial name="_OrderTypeBadge" model="order.Type" /></td>
                        <td class="text-end stock-num">@order.Quantity.ToString("N0")</td>
                        <td class="text-end stock-num">@order.Price.ToString("N0")</td>
                        <td class="small text-secondary d-none d-sm-table-cell text-nowrap">@order.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-end pe-3">
                            <partial name="_CancelOrderButton" model="order" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
