@model PlaceOrderViewModel
<label asp-for="Quantity" class="form-label small"></label>
<div class="input-group">
    <button type="button" class="btn btn-outline-secondary" data-quantity-step="-1" aria-label="-100">−</button>
    <input asp-for="Quantity" type="number" min="100" max="500000" step="100" class="form-control text-center num-font" />
    <button type="button" class="btn btn-outline-secondary" data-quantity-step="1" aria-label="+100">+</button>
</div>
<span asp-validation-for="Quantity" class="field-validation-error"></span>
