@model CashTransferViewModel
@* Form nạp / rút giả lập: hai nút submit dùng formaction khác nhau, investor-wallet.js gửi bằng AJAX. *@
<form id="walletTransferForm" class="stock-card p-3 h-100" asp-action="Deposit" method="post" novalidate>
    <label asp-for="Amount" class="form-label small fw-semibold"></label>
    <div class="input-group">
        <input asp-for="Amount" type="number" min="100000" step="1000" value="" class="form-control" placeholder="10000000" autocomplete="off" />
        <span class="input-group-text">VNĐ</span>
    </div>
    <span asp-validation-for="Amount" class="field-validation-error"></span>
    <div class="d-flex flex-wrap gap-1 my-2">
        @foreach (var preset in new[] { 10_000_000m, 50_000_000m, 100_000_000m })
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" data-amount-preset="@preset.ToString("0", System.Globalization.CultureInfo.InvariantCulture)">@preset.ToString("N0")</button>
        }
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success flex-fill" formaction="@Url.Action("Deposit")">
            <i class="bi bi-box-arrow-in-down me-1"></i>@Localizer["TxDeposit"]
        </button>
        <button type="submit" class="btn btn-outline-danger flex-fill" formaction="@Url.Action("Withdraw")" data-confirm-withdraw="@Localizer["ConfirmWithdraw", "{0}"]">
            <i class="bi bi-box-arrow-up me-1"></i>@Localizer["TxWithdraw"]
        </button>
    </div>
    <p class="form-text small mb-0 mt-2">@Localizer["WalletTransferHint"]</p>
</form>
