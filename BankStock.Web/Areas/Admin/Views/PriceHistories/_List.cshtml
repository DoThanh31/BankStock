@model PagedListViewModel<PriceHistoryListItem, PriceHistoryListQuery>
@{
    var items = Model.Items;
}

<div class="stock-card">
    <partial name="_ListHeader" model="@((items.TotalCount, items.FirstItemNumber, items.LastItemNumber, Model.Query.HasFilters))" />

    <div class="table-responsive">
        <table class="fintech-table">
            <thead>
                <tr>
                    <th class="ps-3">@Localizer["FieldTradeDate"]</th>
                    <th>@Localizer["ThStockCode"]</th>
                    <th class="text-end">@Localizer["ThRef"]</th>
                    <th class="text-end d-none d-md-table-cell">@Localizer["ThCeiling"]</th>
                    <th class="text-end d-none d-md-table-cell">@Localizer["ThFloor"]</th>
                    <th class="text-end d-none d-lg-table-cell">@Localizer["ThOpen"]</th>
                    <th class="text-end d-none d-lg-table-cell">@Localizer["ThHigh"]</th>
                    <th class="text-end d-none d-lg-table-cell">@Localizer["ThLow"]</th>
                    <th class="text-end">@Localizer["ThClose"]</th>
                    <th class="text-end d-none d-sm-table-cell">@Localizer["ThVolume"]</th>
                    <th class="text-end pe-3">@Localizer["ThAction"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var price in items.Items)
                {
                    <tr>
                        <td class="ps-3 stock-num">@price.TradeDate.ToString("d")</td>
                        <td><span class="stock-code-badge @price.StatusClass">@price.StockCode</span></td>
                        <td class="text-end stock-num stock-ref">@price.RefPrice.ToString("N0")</td>
                        <td class="text-end stock-num stock-ceil d-none d-md-table-cell">@price.CeilingPrice.ToString("N0")</td>
                        <td class="text-end stock-num stock-floor d-none d-md-table-cell">@price.FloorPrice.ToString("N0")</td>
                        <td class="text-end stock-num d-none d-lg-table-cell">@price.Open.ToString("N0")</td>
                        <td class="text-end stock-num d-none d-lg-table-cell">@price.High.ToString("N0")</td>
                        <td class="text-end stock-num d-none d-lg-table-cell">@price.Low.ToString("N0")</td>
                        <td class="text-end stock-num fw-bold @price.StatusClass">@price.Close.ToString("N0")</td>
                        <td class="text-end stock-num text-secondary d-none d-sm-table-cell">@price.Volume.ToString("N0")</td>
                        <td class="text-end pe-3 text-nowrap">
                            <button type="button" class="btn btn-outline-warning btn-sm py-0 px-2" title="@Localizer["AdminAdjustPrice"]"
                                    data-modal-url="@Url.Action("Adjust", new { stockId = price.StockId, tradeDate = price.TradeDate.ToString("yyyy-MM-dd") })">
                                <i class="bi bi-sliders"></i>
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" title="@Localizer["BtnEdit"]"
                                    data-modal-url="@Url.Action("Edit", new { id = price.Id })">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" title="@Localizer["BtnDelete"]"
                                    data-confirm-post="@Url.Action("Delete", new { id = price.Id })"
                                    data-confirm-text="@Localizer["ConfirmDeletePrice", price.StockCode, price.TradeDate.ToString("d")]"
                                    data-confirm-button="@Localizer["BtnDelete"]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (items.TotalCount == 0)
                {
                    <partial name="_EmptyRow" model="11" />
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end px-3 py-3">
        <partial name="_Pagination" model="@(new PagerViewModel(items.PageIndex, items.TotalPages, page => Url.Action("Index", Model.Query.ToRouteValues(page))))" />
    </div>
</div>
