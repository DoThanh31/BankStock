@model PagedListViewModel<PriceHistoryListItem, PriceHistoryListQuery>
@{
    ViewData["Title"] = Localizer["AdminNavPriceHistory"];
    var q = Model.Query;
}

<div class="admin-page-header">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-sliders text-primary me-2"></i>@Localizer["AdminNavPriceHistory"]</h3>
        <p class="text-secondary small mb-0">@Localizer["AdminPricesSubtitle"]</p>
    </div>
    <div class="d-flex gap-2">
        @if (q.StockId is { } selectedStockId)
        {
            <button type="button" class="btn btn-outline-warning btn-sm" data-modal-url="@Url.Action("Adjust", new { stockId = selectedStockId })">
                <i class="bi bi-sliders me-1"></i>@Localizer["AdminAdjustPrice"]
            </button>
        }
        <button type="button" class="btn btn-primary btn-sm" data-modal-url="@Url.Action("Create", new { stockId = q.StockId })">
            <i class="bi bi-plus-lg me-1"></i>@Localizer["AdminAddPrice"]
        </button>
    </div>
</div>

<form id="listFilterForm" class="stock-card filter-panel mb-3" method="get" asp-action="Index" role="search">
    <div class="row g-3 align-items-end">
        <div class="col-lg-3 col-md-4">
            <label for="filterStock" class="form-label small text-secondary">@Localizer["FieldStockCode"]</label>
            <select id="filterStock" name="stockId" class="form-select form-select-sm">
                <option value="" selected="@(q.StockId is null)">@Localizer["FilterAllStocks"]</option>
                @foreach (var stock in Model.StockOptions)
                {
                    <option value="@stock.Id" selected="@(q.StockId == stock.Id)">@stock.StockCode (@stock.Exchange)</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <label for="filterFrom" class="form-label small text-secondary">@Localizer["FieldFromDate"]</label>
            <input type="date" id="filterFrom" name="from" value="@q.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-lg-3 col-md-4 col-6">
            <label for="filterTo" class="form-label small text-secondary">@Localizer["FieldToDate"]</label>
            <input type="date" id="filterTo" name="to" value="@q.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <partial name="_FilterActions" model="Model.Query" />
    </div>
</form>

<div id="listResults" aria-live="polite">
    <partial name="_List" model="Model" />
</div>
