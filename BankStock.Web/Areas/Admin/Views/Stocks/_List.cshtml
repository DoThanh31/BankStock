@model PagedListViewModel<StockAdminListItem, StockAdminListQuery>
@{
    var items = Model.Items;
}

<div class="stock-card">
    <partial name="_ListHeader" model="@((items.TotalCount, items.FirstItemNumber, items.LastItemNumber, Model.Query.HasFilters))" />

    <div class="table-responsive">
        <table class="fintech-table">
            <thead>
                <tr>
                    <th class="ps-3">@Localizer["ThStockCode"]</th>
                    <th>@Localizer["FieldBank"]</th>
                    <th class="d-none d-md-table-cell">@Localizer["FieldExchange"]</th>
                    <th class="d-none d-lg-table-cell">@Localizer["FieldBankGroup"]</th>
                    <th>@Localizer["FieldStatus"]</th>
                    <th class="text-end">@Localizer["ThMatchPrice"]</th>
                    <th class="text-end d-none d-md-table-cell">P/E</th>
                    <th class="text-end d-none d-md-table-cell">CASA</th>
                    <th class="text-center d-none d-lg-table-cell">@Localizer["AdminPriceSessions"]</th>
                    <th class="text-end pe-3">@Localizer["ThAction"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var stock in items.Items)
                {
                    <tr class="@(stock.IsActive ? "" : "opacity-75")">
                        <td class="ps-3"><span class="stock-code-badge stock-ref">@stock.StockCode</span></td>
                        <td class="fw-semibold">@stock.BankShortName</td>
                        <td class="d-none d-md-table-cell">@stock.Exchange</td>
                        <td class="d-none d-lg-table-cell">
                            <span class="badge bg-secondary-subtle text-secondary">@(stock.BankGroup == BankGroup.Big4 ? Localizer["FilterBig4"] : Localizer["FilterPrivate"])</span>
                        </td>
                        <td>
                            @if (stock.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">@Localizer["StatusTrading"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">@Localizer["StatusSuspended"]</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="stock-num fw-bold">@(stock.LastClose?.ToString("N0") ?? "—")</div>
                            <div class="small text-secondary">@stock.LastTradeDate?.ToString("d")</div>
                        </td>
                        <td class="text-end stock-num d-none d-md-table-cell">@(stock.PE?.ToString("N1") ?? "—")</td>
                        <td class="text-end stock-num d-none d-md-table-cell">@(stock.CASA is { } casa ? casa.ToString("N1") + "%" : "—")</td>
                        <td class="text-center stock-num d-none d-lg-table-cell">
                            <a asp-controller="PriceHistories" asp-action="Index" asp-route-stockId="@stock.Id">@stock.PriceCount</a>
                        </td>
                        <td class="text-end pe-3 text-nowrap">
                            <button type="button" class="btn btn-outline-warning btn-sm py-0 px-2" title="@Localizer["AdminAdjustPrice"]"
                                    data-modal-url="@Url.Action("Adjust", "PriceHistories", new { stockId = stock.Id })">
                                <i class="bi bi-sliders"></i>
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" title="@Localizer["BtnEdit"]"
                                    data-modal-url="@Url.Action("Edit", new { id = stock.Id })">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            @if (stock.IsActive)
                            {
                                <a class="btn btn-outline-secondary btn-sm py-0 px-2" title="@Localizer["BtnDetail"]" target="_blank"
                                   href="@Url.Action("Details", "Stocks", new { area = "", code = stock.StockCode })">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            }
                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" title="@Localizer["BtnDelete"]"
                                    data-confirm-post="@Url.Action("Delete", new { id = stock.Id })"
                                    data-confirm-text="@Localizer["ConfirmDeleteStock", stock.StockCode, stock.PriceCount]"
                                    data-confirm-button="@Localizer["BtnDelete"]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (items.TotalCount == 0)
                {
                    <partial name="_EmptyRow" model="10" />
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end px-3 py-3">
        <partial name="_Pagination" model="@(new PagerViewModel(items.PageIndex, items.TotalPages, page => Url.Action("Index", Model.Query.ToRouteValues(page))))" />
    </div>
</div>
