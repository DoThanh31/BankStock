@model PagedListViewModel<StockAdminListItem, StockAdminListQuery>
@{
    ViewData["Title"] = Localizer["AdminNavStocks"];
    var q = Model.Query;
}

<div class="admin-page-header">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-graph-up text-primary me-2"></i>@Localizer["AdminNavStocks"]</h3>
        <p class="text-secondary small mb-0">@Localizer["AdminStocksSubtitle"]</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm" data-modal-url="@Url.Action("Create")">
        <i class="bi bi-plus-lg me-1"></i>@Localizer["AdminAddStock"]
    </button>
</div>

<form id="listFilterForm" class="stock-card filter-panel mb-3" method="get" asp-action="Index" role="search">
    <div class="row g-3 align-items-end">
        <div class="col-lg-3 col-md-6">
            <label for="filterQ" class="form-label small text-secondary">@Localizer["FieldSearch"]</label>
            <input type="search" id="filterQ" name="q" value="@q.Q" maxlength="100" class="form-control form-control-sm"
                   placeholder="@Localizer["SearchPlaceholder"]" autocomplete="off" />
        </div>
        <div class="col-lg-2 col-md-3 col-6">
            <label for="filterGroup" class="form-label small text-secondary">@Localizer["FieldBankGroup"]</label>
            <select id="filterGroup" name="group" class="form-select form-select-sm">
                <option value="" selected="@(q.Group is null)">@Localizer["FilterAll"]</option>
                <option value="Big4" selected="@(q.Group == BankGroup.Big4)">@Localizer["FilterBig4"]</option>
                <option value="PrivateJSC" selected="@(q.Group == BankGroup.PrivateJSC)">@Localizer["FilterPrivate"]</option>
            </select>
        </div>
        <div class="col-lg-1 col-md-3 col-6">
            <label for="filterExchange" class="form-label small text-secondary">@Localizer["FieldExchange"]</label>
            <select id="filterExchange" name="exchange" class="form-select form-select-sm">
                <option value="" selected="@(q.Exchange is null)">@Localizer["FilterAll"]</option>
                @foreach (var exchange in BankStock.Web.Services.PriceRules.Exchanges)
                {
                    <option value="@exchange" selected="@(q.Exchange == exchange)">@exchange</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-3 col-6">
            <label for="filterActive" class="form-label small text-secondary">@Localizer["FieldStatus"]</label>
            <select id="filterActive" name="active" class="form-select form-select-sm">
                <option value="" selected="@(q.Active is null)">@Localizer["FilterAll"]</option>
                <option value="true" selected="@(q.Active == true)">@Localizer["StatusTrading"]</option>
                <option value="false" selected="@(q.Active == false)">@Localizer["StatusSuspended"]</option>
            </select>
        </div>
        <partial name="_FilterActions" model="Model.Query" />
    </div>
</form>

<div id="listResults" aria-live="polite">
    <partial name="_List" model="Model" />
</div>
