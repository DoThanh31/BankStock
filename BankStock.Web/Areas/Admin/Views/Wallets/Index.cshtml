@model PagedListViewModel<WalletListItem, PagedListQuery>
@{
    ViewData["Title"] = Localizer["AdminNavWallets"];
    var stats = ViewData["WalletStats"] as WalletStatsViewModel ?? new WalletStatsViewModel();
}

<div class="admin-page-header">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-wallet-fill text-primary me-2"></i>@Localizer["AdminNavWallets"]</h3>
        <p class="text-secondary small mb-0">@Localizer["AdminWalletsSubtitle"]</p>
    </div>
</div>

<partial name="_WalletStats" model="stats" />

<form id="listFilterForm" class="stock-card filter-panel mb-3" method="get" asp-action="Index" role="search">
    <div class="row g-3 align-items-end">
        <div class="col-lg-8 col-md-6">
            <label for="filterQ" class="form-label small text-secondary">@Localizer["FieldSearch"]</label>
            <input type="search" id="filterQ" name="q" value="@Model.Query.Q" maxlength="100" class="form-control form-control-sm"
                   placeholder="@Localizer["AdminUserSearchPlaceholder"]" autocomplete="off" />
        </div>
        <partial name="_FilterActions" model="Model.Query" />
    </div>
</form>

<div id="listResults" aria-live="polite">
    <partial name="_List" model="Model" />
</div>
