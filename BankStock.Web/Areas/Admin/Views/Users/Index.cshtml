@model PagedListViewModel<UserAdminListItem, UserListQuery>
@{
    ViewData["Title"] = Localizer["AdminNavUsers"];
    var q = Model.Query;
}

<div class="admin-page-header">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>@Localizer["AdminNavUsers"]</h3>
        <p class="text-secondary small mb-0">@Localizer["AdminUsersSubtitle"]</p>
    </div>
</div>

<form id="listFilterForm" class="stock-card filter-panel mb-3" method="get" asp-action="Index" role="search">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4 col-md-6">
            <label for="filterQ" class="form-label small text-secondary">@Localizer["FieldSearch"]</label>
            <input type="search" id="filterQ" name="q" value="@q.Q" maxlength="100" class="form-control form-control-sm"
                   placeholder="@Localizer["AdminUserSearchPlaceholder"]" autocomplete="off" />
        </div>
        <div class="col-lg-2 col-md-3 col-6">
            <label for="filterRole" class="form-label small text-secondary">@Localizer["FieldRole"]</label>
            <select id="filterRole" name="role" class="form-select form-select-sm">
                <option value="" selected="@(q.Role is null)">@Localizer["FilterAll"]</option>
                <option value="@AppRoles.Admin" selected="@(q.Role == AppRoles.Admin)">@Localizer["RoleAdmin"]</option>
                <option value="@AppRoles.Investor" selected="@(q.Role == AppRoles.Investor)">@Localizer["RoleInvestor"]</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-3 col-6">
            <label for="filterStatus" class="form-label small text-secondary">@Localizer["FieldStatus"]</label>
            <select id="filterStatus" name="status" class="form-select form-select-sm">
                <option value="" selected="@(q.Status is null)">@Localizer["FilterAll"]</option>
                @foreach (var status in Enum.GetValues<UserStatusFilter>())
                {
                    <option value="@status" selected="@(q.Status == status)">@Localizer["UserStatus" + status]</option>
                }
            </select>
        </div>
        <partial name="_FilterActions" model="Model.Query" />
    </div>
</form>

<div id="listResults" aria-live="polite">
    <partial name="_List" model="Model" />
</div>
