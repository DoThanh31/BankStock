@model PagedListViewModel<AuditLogListItem, AuditLogListQuery>
@{
    ViewData["Title"] = Localizer["AdminNavAudit"];
    var q = Model.Query;
}

<div class="admin-page-header">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-clock-history text-primary me-2"></i>@Localizer["AdminNavAudit"]</h3>
        <p class="text-secondary small mb-0">@Localizer["AdminAuditSubtitle"]</p>
    </div>
</div>

<form id="listFilterForm" class="stock-card filter-panel mb-3" method="get" asp-action="Index" role="search">
    <div class="row g-3 align-items-end">
        <div class="col-lg-3 col-md-6">
            <label for="filterQ" class="form-label small text-secondary">@Localizer["FieldSearch"]</label>
            <input type="search" id="filterQ" name="q" value="@q.Q" maxlength="100" class="form-control form-control-sm"
                   placeholder="@Localizer["AdminAuditSearchPlaceholder"]" autocomplete="off" />
        </div>
        <div class="col-lg-2 col-md-6">
            <label for="filterAction" class="form-label small text-secondary">@Localizer["FieldAuditAction"]</label>
            <select id="filterAction" name="logAction" class="form-select form-select-sm">
                <option value="" selected="@(q.LogAction is null)">@Localizer["FilterAll"]</option>
                @foreach (var action in Model.FilterOptions)
                {
                    <option value="@action" selected="@(q.LogAction == action)">@action</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-3 col-6">
            <label for="filterFrom" class="form-label small text-secondary">@Localizer["FieldFromDate"]</label>
            <input type="date" id="filterFrom" name="from" value="@q.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-lg-1 col-md-3 col-6">
            <label for="filterTo" class="form-label small text-secondary">@Localizer["FieldToDate"]</label>
            <input type="date" id="filterTo" name="to" value="@q.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <partial name="_FilterActions" model="Model.Query" />
    </div>
</form>

<div id="listResults" aria-live="polite">
    <partial name="_List" model="Model" />
</div>
