@model PagedListViewModel<AuditLogListItem, AuditLogListQuery>
@{
    var items = Model.Items;
}

<div class="stock-card">
    <partial name="_ListHeader" model="@((items.TotalCount, items.FirstItemNumber, items.LastItemNumber, Model.Query.HasFilters))" />

    <div class="table-responsive">
        <table class="fintech-table">
            <thead>
                <tr>
                    <th class="ps-3">@Localizer["AdminTime"]</th>
                    <th>@Localizer["FieldAuditAction"]</th>
                    <th>@Localizer["AdminActor"]</th>
                    <th class="d-none d-md-table-cell">@Localizer["AdminEntity"]</th>
                    <th class="d-none d-lg-table-cell">@Localizer["FieldDescription"]</th>
                    <th class="d-none d-xl-table-cell pe-3">IP</th>
                </tr>
            </thead>
            <tbody>
                <partial name="_AuditRows" model="items.Items" />
                @if (items.TotalCount == 0)
                {
                    <partial name="_EmptyRow" model="6" />
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end px-3 py-3">
        <partial name="_Pagination" model="@(new PagerViewModel(items.PageIndex, items.TotalPages, page => Url.Action("Index", Model.Query.ToRouteValues(page))))" />
    </div>
</div>
