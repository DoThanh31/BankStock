@model PagedListViewModel<BankAdminListItem, PagedListQuery>
@{
    var items = Model.Items;
}

<div class="stock-card">
    <partial name="_ListHeader" model="@((items.TotalCount, items.FirstItemNumber, items.LastItemNumber, Model.Query.HasFilters))" />

    <div class="table-responsive">
        <table class="fintech-table">
            <thead>
                <tr>
                    <th class="ps-3">@Localizer["FieldBankCode"]</th>
                    <th>@Localizer["ThBankName"]</th>
                    <th class="d-none d-md-table-cell">@Localizer["BankFounded"]</th>
                    <th class="d-none d-lg-table-cell">@Localizer["BankHeadquarters"]</th>
                    <th class="text-center">@Localizer["AdminStockCount"]</th>
                    <th class="text-end pe-3">@Localizer["ThAction"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bank in items.Items)
                {
                    <tr>
                        <td class="ps-3">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(bank.LogoUrl))
                                {
                                    <img src="@bank.LogoUrl" alt="" class="admin-bank-logo" loading="lazy" referrerpolicy="no-referrer" />
                                }
                                <span class="stock-code-badge stock-ref">@bank.Code</span>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold">@bank.ShortName</div>
                            <div class="small text-secondary">@bank.Name</div>
                            @if (!string.IsNullOrEmpty(bank.Website))
                            {
                                <a href="@bank.Website" target="_blank" rel="noopener noreferrer" class="small">@bank.Website</a>
                            }
                        </td>
                        <td class="d-none d-md-table-cell stock-num">@(bank.Founded?.ToString() ?? "—")</td>
                        <td class="d-none d-lg-table-cell text-secondary small">@(bank.Headquarters ?? "—")</td>
                        <td class="text-center stock-num">@bank.StockCount</td>
                        <td class="text-end pe-3 text-nowrap">
                            <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" title="@Localizer["BtnEdit"]"
                                    data-modal-url="@Url.Action("Edit", new { id = bank.Id })">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" title="@Localizer["BtnDelete"]"
                                    data-confirm-post="@Url.Action("Delete", new { id = bank.Id })"
                                    data-confirm-text="@Localizer["ConfirmDeleteBank", bank.Code]"
                                    data-confirm-button="@Localizer["BtnDelete"]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (items.TotalCount == 0)
                {
                    <partial name="_EmptyRow" model="6" />
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end px-3 py-3">
        <partial name="_Pagination" model="@(new PagerViewModel(items.PageIndex, items.TotalPages, page => Url.Action("Index", Model.Query.ToRouteValues(page))))" />
    </div>
</div>
