@model PagedListViewModel<BankAdminListItem, PagedListQuery>
@{
    ViewData["Title"] = Localizer["AdminNavBanks"];
}

<div class="admin-page-header">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-bank2 text-primary me-2"></i>@Localizer["AdminNavBanks"]</h3>
        <p class="text-secondary small mb-0">@Localizer["AdminBanksSubtitle"]</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm" data-modal-url="@Url.Action("Create")">
        <i class="bi bi-plus-lg me-1"></i>@Localizer["AdminAddBank"]
    </button>
</div>

<form id="listFilterForm" class="stock-card filter-panel mb-3" method="get" asp-action="Index" role="search">
    <div class="row g-3 align-items-end">
        <div class="col-lg-8 col-md-6">
            <label for="filterQ" class="form-label small text-secondary">@Localizer["FieldSearch"]</label>
            <input type="search" id="filterQ" name="q" value="@Model.Query.Q" maxlength="100" class="form-control form-control-sm"
                   placeholder="@Localizer["AdminBankSearchPlaceholder"]" autocomplete="off" />
        </div>
        <partial name="_FilterActions" model="Model.Query" />
    </div>
</form>

<div id="listResults" aria-live="polite">
    <partial name="_List" model="Model" />
</div>
