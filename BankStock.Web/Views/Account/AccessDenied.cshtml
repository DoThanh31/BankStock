@{
    ViewData["Title"] = Localizer["AccessDeniedTitle"];
}

<div class="auth-wrapper">
    <div class="stock-card auth-card text-center">
        <span class="auth-icon mb-2 text-danger"><i class="bi bi-slash-circle"></i></span>
        <h1 class="h4 fw-bold mb-2">@Localizer["AccessDeniedTitle"]</h1>
        <p class="text-secondary small">@Localizer["AccessDeniedMessage"]</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2"><i class="bi bi-house me-1"></i>@Localizer["BtnBackHome"]</a>
    </div>
</div>
