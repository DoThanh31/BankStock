@model ResetPasswordViewModel
@{
    ViewData["Title"] = Localizer["ResetPasswordTitle"];
}

<div class="auth-wrapper">
    <div class="stock-card auth-card">
        <div class="text-center mb-4">
            <span class="auth-icon mb-2"><i class="bi bi-shield-lock"></i></span>
            <h1 class="h4 fw-bold mb-1">@Localizer["ResetPasswordTitle"]</h1>
        </div>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>
            <input asp-for="Code" type="hidden" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label small"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="passwordHelp" autofocus />
                <div id="passwordHelp" class="form-text small">@Localizer["PasswordHint"]</div>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label small"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-check2-circle me-1"></i>@Localizer["ResetPasswordSubmit"]
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
