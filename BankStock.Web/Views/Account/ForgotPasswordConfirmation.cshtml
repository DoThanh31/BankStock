@{
    ViewData["Title"] = Localizer["ForgotPasswordTitle"];
    var devResetLink = ViewData["DevResetLink"] as string;
}

<div class="auth-wrapper">
    <div class="stock-card auth-card text-center">
        <span class="auth-icon mb-2"><i class="bi bi-envelope-check"></i></span>
        <h1 class="h4 fw-bold mb-2">@Localizer["ForgotPasswordConfirmTitle"]</h1>
        <p class="text-secondary small">@Localizer["ForgotPasswordConfirmMessage"]</p>

        @if (!string.IsNullOrEmpty(devResetLink))
        {
            <div class="alert alert-warning small text-start" role="note">
                <div class="fw-semibold mb-1"><i class="bi bi-bug me-1"></i>@Localizer["DevResetLinkNotice"]</div>
                <a href="@devResetLink" class="text-break">@devResetLink</a>
            </div>
        }

        <a asp-action="Login" class="btn btn-outline-secondary btn-sm mt-2"><i class="bi bi-arrow-left me-1"></i>@Localizer["BackToLogin"]</a>
    </div>
</div>
