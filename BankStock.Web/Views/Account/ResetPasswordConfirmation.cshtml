@{
    ViewData["Title"] = Localizer["ResetPasswordTitle"];
}

<div class="auth-wrapper">
    <div class="stock-card auth-card text-center">
        <span class="auth-icon mb-2"><i class="bi bi-check2-circle"></i></span>
        <h1 class="h4 fw-bold mb-2">@Localizer["ResetPasswordDoneTitle"]</h1>
        <p class="text-secondary small">@Localizer["ResetPasswordDoneMessage"]</p>
        <a asp-action="Login" class="btn btn-primary btn-sm mt-2"><i class="bi bi-box-arrow-in-right me-1"></i>@Localizer["NavLogin"]</a>
    </div>
</div>
