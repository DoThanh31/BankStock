@model ForgotPasswordViewModel
@{
    ViewData["Title"] = Localizer["ForgotPasswordTitle"];
}

<div class="auth-wrapper">
    <div class="stock-card auth-card">
        <div class="text-center mb-4">
            <span class="auth-icon mb-2"><i class="bi bi-key"></i></span>
            <h1 class="h4 fw-bold mb-1">@Localizer["ForgotPasswordTitle"]</h1>
            <p class="text-secondary small mb-0">@Localizer["ForgotPasswordSubtitle"]</p>
        </div>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-send me-1"></i>@Localizer["ForgotPasswordSubmit"]
            </button>
        </form>

        <p class="text-center small mt-4 mb-0">
            <a asp-action="Login"><i class="bi bi-arrow-left me-1"></i>@Localizer["BackToLogin"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
