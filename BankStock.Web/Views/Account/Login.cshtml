@model LoginViewModel
@{
    ViewData["Title"] = Localizer["LoginTitle"];
}

<div class="auth-wrapper">
    <div class="stock-card auth-card">
        <div class="text-center mb-4">
            <span class="auth-icon mb-2"><i class="bi bi-box-arrow-in-right"></i></span>
            <h1 class="h4 fw-bold mb-1">@Localizer["LoginTitle"]</h1>
            <p class="text-secondary small mb-0">@Localizer["LoginSubtitle"]</p>
        </div>

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label asp-for="Password" class="form-label small"></label>
                    <a asp-action="ForgotPassword" class="small">@Localizer["ForgotPasswordLink"]</a>
                </div>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-box-arrow-in-right me-1"></i>@Localizer["NavLogin"]
            </button>
        </form>

        <p class="text-center small text-secondary mt-4 mb-0">
            @Localizer["NoAccountYet"]
            <a asp-action="Register">@Localizer["NavRegister"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
