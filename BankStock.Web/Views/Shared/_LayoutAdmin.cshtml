@using Microsoft.AspNetCore.Localization
@{
    var currentTheme = Context.Request.Cookies["theme"] ?? "dark";
    if (currentTheme != "light" && currentTheme != "dark")
    {
        currentTheme = "dark";
    }

    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "vi-VN";
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    string NavActive(string controller) => string.Equals(controller, currentController, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="@(currentCulture.StartsWith("vi") ? "vi" : "en")" data-bs-theme="@currentTheme" data-theme="@currentTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["AdminDashboard"] - BankStock</title>
    
    <!-- Zero-flash theme bootstrapper -->
    <script src="~/js/theme-init.js" asp-append-version="true"></script>

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous" />
    
    <!-- Base Theme & Admin CSS -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar Backdrop for mobile -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-sidebar-brand">
                <span class="brand-icon"><i class="bi bi-shield-lock-fill"></i></span>
                <span>BankStock <span class="badge bg-primary text-uppercase" style="font-size: 0.65rem;">Admin</span></span>
            </a>

            <ul class="admin-sidebar-menu">
                <!-- CORE -->
                <li class="admin-menu-header">@Localizer["AdminSidebarCore"]</li>
                <li class="admin-nav-item">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-nav-link @NavActive("Dashboard")">
                        <i class="bi bi-speedometer2"></i>
                        <span>@Localizer["AdminNavDashboard"]</span>
                    </a>
                </li>

                <!-- DATA MANAGEMENT -->
                <li class="admin-menu-header">@Localizer["AdminSidebarData"]</li>
                <li class="admin-nav-item">
                    <a asp-area="Admin" asp-controller="Banks" asp-action="Index" class="admin-nav-link @NavActive("Banks")">
                        <i class="bi bi-bank2"></i>
                        <span>@Localizer["AdminNavBanks"]</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-area="Admin" asp-controller="Stocks" asp-action="Index" class="admin-nav-link @NavActive("Stocks")">
                        <i class="bi bi-graph-up"></i>
                        <span>@Localizer["AdminNavStocks"]</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-area="Admin" asp-controller="PriceHistories" asp-action="Index" class="admin-nav-link @NavActive("PriceHistories")">
                        <i class="bi bi-sliders"></i>
                        <span>@Localizer["AdminNavPriceHistory"]</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-area="Admin" asp-controller="FinancialReports" asp-action="Index" class="admin-nav-link @NavActive("FinancialReports")">
                        <i class="bi bi-file-earmark-bar-graph"></i>
                        <span>@Localizer["AdminNavReports"]</span>
                    </a>
                </li>

                <!-- USERS & TRADING -->
                <li class="admin-menu-header">@Localizer["AdminSidebarUsers"]</li>
                <li class="admin-nav-item">
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="admin-nav-link @NavActive("Users")">
                        <i class="bi bi-people"></i>
                        <span>@Localizer["AdminNavUsers"]</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-area="Admin" asp-controller="Wallets" asp-action="Index" class="admin-nav-link @NavActive("Wallets")">
                        <i class="bi bi-wallet-fill"></i>
                        <span>@Localizer["AdminNavWallets"]</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="admin-nav-link @NavActive("Orders")">
                        <i class="bi bi-receipt-cutoff"></i>
                        <span>@Localizer["AdminNavOrders"]</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" class="admin-nav-link @NavActive("AuditLogs")">
                        <i class="bi bi-clock-history"></i>
                        <span>@Localizer["AdminNavAudit"]</span>
                    </a>
                </li>

                <!-- SYSTEM -->
                <li class="admin-menu-header">@Localizer["AdminSidebarSystem"]</li>
                <li class="admin-nav-item">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-nav-link text-info">
                        <i class="bi bi-box-arrow-left"></i>
                        <span>@Localizer["AdminNavBackToMarket"]</span>
                    </a>
                </li>
            </ul>
        </aside>

        <!-- Main Body -->
        <div class="admin-main">
            <!-- Topbar -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggleBtn" type="button" aria-label="@Localizer["SidebarToggle"]">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <span class="fw-bold d-none d-sm-inline-block">@ViewData["Title"]</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <!-- Theme Toggle -->
                    <button type="button" class="btn-theme-toggle" data-action="toggle-theme" title="@Localizer["NavThemeToggle"]"
                            data-title-to-dark="@Localizer["ThemeSwitchToDark"]" data-title-to-light="@Localizer["ThemeSwitchToLight"]">
                        <i class="bi bi-sun-fill"></i>
                    </button>

                    <!-- Language Selector -->

                    <partial name="_Language" />

                    <!-- Admin Profile Dropdown -->
                    <div class="dropdown ms-2">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-fill-gear"></i>
                            <span class="d-none d-md-inline">@User.Identity?.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><h6 class="dropdown-header">@User.Identity?.Name</h6></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>@Localizer["NavLogout"]</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Content -->
            <main class="admin-content-body">
                @RenderBody()
            </main>

            <!-- Modal dùng chung cho form CRUD (nội dung nạp bằng AJAX, xem admin-crud.js) -->
            <div class="modal fade" id="adminModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content admin-modal-content" id="adminModalContent"></div>
                </div>
            </div>

            <partial name="_JsI18n" />

            <!-- Admin Footer -->
            <footer class="admin-footer d-flex flex-wrap justify-content-between align-items-center">
                <div>@Localizer["FooterCopyright"]</div>
                <div>BankStock Admin v1.0.0 · SB Admin 2 / AdminLTE System</div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/validation-extensions.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js" integrity="sha384-YB/DdIkloKoRpclWB8bNcYXWakt57USgtQPDzvnIDHYU0lasD5eWlXVo1S4ODukY" crossorigin="anonymous"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/ui-common.js" asp-append-version="true"></script>
    <script src="~/js/ajax-list.js" asp-append-version="true"></script>
    <script src="~/js/admin-crud.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
