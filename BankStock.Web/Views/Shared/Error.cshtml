@model BankStock.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = Localizer["Error500Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 text-center">
            <div class="error-hero">
                <div class="error-code">500</div>
                <h2 class="fw-bold mb-3">@Localizer["Error500Title"]</h2>
                <p class="text-secondary lead mb-4">
                    @Localizer["Error500Message"]
                </p>

                @if (Model.ShowRequestId)
                {
                    <div class="p-3 bg-body-tertiary border border-subtle rounded-3 d-inline-block text-start mb-4 small">
                        <span class="text-secondary">@Localizer["ErrorRequestId"]:</span>
                        <code class="text-primary font-monospace ms-1">@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                        <i class="bi bi-house-door me-2"></i>@Localizer["BtnBackHome"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
