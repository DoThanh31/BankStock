@model List<StockBoardItemViewModel>
@if (Model.Count > 0)
{
    <div class="recent-stocks">
        <span class="ticker-label me-1"><i class="bi bi-clock-history me-1"></i>@Localizer["RecentlyViewed"]</span>
        @foreach (var stock in Model)
        {
            <a class="recent-stock-chip" asp-controller="Stocks" asp-action="Details" asp-route-code="@stock.StockCode">
                <span class="fw-bold">@stock.StockCode</span>
                <span class="num-font @stock.StatusClass">@stock.CurrentPrice.ToString("N0")</span>
                <span class="num-font small @stock.StatusClass">@stock.ChangePercentDisplay</span>
            </a>
        }
    </div>
}
