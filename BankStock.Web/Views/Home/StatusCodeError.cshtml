@model BankStock.Web.Models.ErrorViewModel
@{
    var statusCode = Model.StatusCode ?? 404;
    var is404 = statusCode == 404;
    var is500 = statusCode == 500;
    
    var title = is404 
        ? Localizer["Error404Title"].Value 
        : (is500 ? Localizer["Error500Title"].Value : Localizer["ErrorDefaultTitle"].Value);
    
    var message = is404 
        ? Localizer["Error404Message"].Value 
        : (is500 ? Localizer["Error500Message"].Value : Localizer["ErrorDefaultMessage"].Value);

    ViewData["Title"] = $"{statusCode} - {title}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 text-center">
            <div class="error-hero">
                <div class="error-code">@statusCode</div>
                <h2 class="fw-bold mb-3">@title</h2>
                <p class="text-secondary lead mb-4">
                    @message
                </p>

                @if (Model.ShowRequestId)
                {
                    <div class="p-3 bg-body-tertiary border border-subtle rounded-3 d-inline-block text-start mb-4 small">
                        <span class="text-secondary">@Localizer["ErrorRequestId"]:</span>
                        <code class="text-primary font-monospace ms-1">@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                        <i class="bi bi-house-door me-2"></i>@Localizer["BtnBackHome"]
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                        <i class="bi bi-table me-2"></i>@Localizer["BtnBackBoard"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
